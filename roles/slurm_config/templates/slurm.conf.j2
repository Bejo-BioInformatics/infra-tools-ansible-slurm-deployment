# slurm.conf file generated by Ansible
ClusterName={{ slurm_cluster_title }}
SlurmctldHost={{ hostvars[slurm_primary_controller_name].ansible_facts.hostname }}
#ControlMachine={{ hostvars[slurm_primary_controller_name].ansible_facts.hostname }}

AuthType=auth/munge

# Process tracking
#ProctrackType=proctrack/pgid
#ReturnToService=2
ProctrackType=proctrack/cgroup
TaskPlugin=task/cgroup,task/affinity


# PID and Port configurations
SlurmctldPidFile=/run/slurm/slurmctld.pid
SlurmctldPort=6817
SlurmdPidFile=/run/slurm/slurmd.pid
SlurmdPort=6818
SlurmdSpoolDir=/var/spool/slurmd
SlurmUser=slurm


# State save location
StateSaveLocation=/var/spool/slurmctld


# TIMERS
InactiveLimit=0
KillWait=30
MinJobAge=300
SlurmctldTimeout=120
SlurmdTimeout=300
Waittime=0

# SCHEDULING
SchedulerType=sched/backfill
SelectType=select/cons_tres
SelectTypeParameters=CR_Core_Memory
MaxNodeCount=1024
SwitchType=switch/none
MpiDefault=none

# LOGGING AND ACCOUNTING
AccountingStorageHost={{ hostvars[slurm_primary_controller_name].ansible_facts.hostname }}
AccountingStorageType=accounting_storage/slurmdbd
#AccountingStorageUser=slurm
AccountingStoragePort=6819
JobAcctGatherFrequency=30
JobAcctGatherType=jobacct_gather/none
SlurmctldDebug=info
SlurmctldLogFile=/var/log/slurm/slurmctld.log
SlurmdDebug=info
SlurmdLogFile=/var/log/slurm/slurmd.log


{% if slurm_web_activated %}
AuthAltTypes=auth/jwt
AuthAltParameters=jwt_key=/var/spool/slurmd/jwt_hs256.key
{% endif %}


# DYNAMIC NODE LIST - All nodes get same list
{% if ('slurm_computes_cpu' in groups) and ((groups['slurm_computes_cpu']|length) > 0) %}
{#-#}
{% for host in groups['slurm_computes_cpu'] %}
{% if ('ansible_facts' in hostvars[host]) and ('hostname' in hostvars[host].ansible_facts) %}
NodeName={{ hostvars[host].ansible_facts.hostname }} NodeHostname={{ hostvars[host].ansible_facts.hostname }} SocketsPerBoard={{ hostvars[host].ansible_facts.processor_count }} CPUs={{ hostvars[host].ansible_facts.processor_nproc }} CoresPerSocket={{ hostvars[host].ansible_facts.processor_cores }} ThreadsPerCore={{ hostvars[host].ansible_facts.processor_threads_per_core }} RealMemory={{ hostvars[host].ansible_facts.memtotal_mb }} State=UNKNOWN
{% endif %}
{% endfor %}
{% endif %}
{#-#}
{% if ('slurm_computes_gpu' in groups) and ((groups['slurm_computes_gpu']|length) > 0) %}
{% for host in groups['slurm_computes_gpu'] %}
{% if ('ansible_facts' in hostvars[host]) and ('hostname' in hostvars[host].ansible_facts) %}
NodeName={{ hostvars[host].ansible_facts.hostname }} NodeHostname={{ hostvars[host].ansible_facts.hostname }} SocketsPerBoard={{ hostvars[host].ansible_facts.processor_count }} CPUs={{ hostvars[host].ansible_facts.processor_nproc }} CoresPerSocket={{ hostvars[host].ansible_facts.processor_cores }} ThreadsPerCore={{ hostvars[host].ansible_facts.processor_threads_per_core }} RealMemory={{ hostvars[host].ansible_facts.memtotal_mb }} State=UNKNOWN
{% endif %}
{% endfor %}
{% endif %}



# DYNAMIC PARTITION
PartitionName=debug Nodes={% for host in (('slurm_computes_cpu' in groups) | ternary(groups['slurm_computes_cpu'], [])) + (('slurm_computes_gpu' in groups) | ternary(groups['slurm_computes_gpu'], [])) %}{{ hostvars[host].ansible_facts.hostname }}{% if not loop.last %},{% endif %}{% endfor %} Default=YES MaxTime=INFINITE State=UP
{##}
{% if ('slurm_computes_cpu' in groups) and ((groups['slurm_computes_cpu']|length) > 0) %}
PartitionName=cpu   Nodes={% for host in groups['slurm_computes_cpu'] %}{{ hostvars[host].ansible_facts.hostname }}{% if not loop.last %},{% endif %}{% endfor %} Default=YES MaxTime=INFINITE State=UP
{% endif %}
{#-#}
{% if ('slurm_computes_gpu' in groups) and ((groups['slurm_computes_gpu']|length) > 0) %}
PartitionName=gpu   Nodes={% for host in groups['slurm_computes_gpu'] %}{{ hostvars[host].ansible_facts.hostname }}{% if not loop.last %},{% endif %}{% endfor %} Default=YES MaxTime=INFINITE State=UP
{% endif %}



